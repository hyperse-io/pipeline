{
  "name": "@hyperse/pipeline-website",
  "version": "0.0.1",
  "description": "Hyperse Pipeline Website",
  "private": true,
  "homepage": "https://github.com/hyperse-io/pipeline#readme",
  "bugs": {
    "url": "https://github.com/hyperse-io/pipeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/pipeline.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "yarn build:pipeline && next build && yarn postbuild",
    "build:pipeline": "yarn workspace @hyperse/pipeline build",
    "postbuild": "next-sitemap",
    "build:ghpage": "yarn build:pipeline && cross-env NEXT_BUILD_ENV_OUTPUT='export' next build && yarn postbuild:ghpage",
    "postbuild:ghpage": "next-sitemap",
    "dev": "next dev -p 3000 -H 0.0.0.0 --turbopack",
    "fix-all-files": "eslint . --fix",
    "g:lint-staged-files": "lint-staged --allow-empty",
    "lint": "eslint .",
    "start": "next start -p 3000 -H 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@hyperse/pipeline": "workspace:*",
    "clsx": "^2.1.1",
    "framer-motion": "^14.2.0",
    "fumadocs-core": "16.17.3",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-twoslash": "4.0.2",
    "fumadocs-typescript": "5.5.2",
    "fumadocs-ui": "16.17.3",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.1",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@hyperse/next-config": "^1.0.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "lint-staged": "^17.6.0",
    "next-sitemap": "^4.2.3",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "zod": "^4.6.7"
  }
}
